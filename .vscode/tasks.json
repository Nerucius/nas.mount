{
    // Stop the running nas-mount instance (unmounting the volumes) and, for
    // the remount tasks, hand a fresh one to the OS service manager -
    // launchd on macOS, Task Scheduler on Windows. Remounts print the new
    // run's startup log and exit; the mounts survive closing the terminal.
    // Terminal > Run Task... > pick the one for this machine's OS.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "NAS: Remount all (macOS)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            // mount.sh restart: SIGINT the old process (clean unmount +
            // delete drain), bootout/bootstrap the LaunchAgent, tail the
            // new run's startup lines. Installs the agent first if needed.
            "command": "./mount.sh restart",
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "NAS: Unmount all (macOS)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            // mount.sh stop also boots the agent out, so a non-clean exit
            // (the SIGKILL fallback) can't have launchd mount straight
            // back up. Stays down until a remount or the next login; the
            // agent is not uninstalled.
            "command": "./mount.sh stop",
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "panel": "shared",
                "reveal": "always"
            }
        },
        {
            "label": "NAS: Status (macOS)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "./mount.sh status; tail -n 20 nas-mount.log",
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "panel": "shared",
                "reveal": "always"
            }
        },
        {
            "label": "NAS: Remount all (Windows)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            // Restart the 'nas-mount' scheduled task so the mounter keeps
            // running under Task Scheduler instead of this terminal. The
            // explicit kill covers python children Stop-ScheduledTask
            // leaves behind; WinFsp drops the drive letters as soon as the
            // old process dies, and mount.ps1 re-kills stragglers anyway.
            "command": "if (-not (Get-ScheduledTask -TaskName 'nas-mount' -ErrorAction SilentlyContinue)) { Write-Host 'scheduled task ''nas-mount'' is not registered - run the Register-ScheduledTask snippet from README.md (Auto-start at login) once, from an elevated PowerShell'; exit 1 }; Stop-ScheduledTask -TaskName 'nas-mount' -ErrorAction SilentlyContinue; Get-CimInstance Win32_Process -Filter \"Name LIKE 'python%'\" | Where-Object { $_.CommandLine -like '*nas_mount*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }; Start-Sleep -Seconds 3; Start-ScheduledTask -TaskName 'nas-mount'; Start-Sleep -Seconds 10; Get-Content nas-mount.log -Tail 25; Write-Host '--- scheduled task nas-mount owns the mounts now; logs: nas-mount.log ---'",
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "reveal": "always",
                "clear": true
            }
        },
        {
            "label": "NAS: Unmount all (Windows)",
            "type": "shell",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            // Stop the scheduled task too, or it restarts the mounter.
            "command": "Stop-ScheduledTask -TaskName 'nas-mount' -ErrorAction SilentlyContinue; Get-CimInstance Win32_Process -Filter \"Name LIKE 'python%'\" | Where-Object { $_.CommandLine -like '*nas_mount*' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }; Write-Host 'All NAS drives unmounted.'",
            "isBackground": false,
            "problemMatcher": [],
            "presentation": {
                "panel": "shared",
                "reveal": "always"
            }
        }
    ]
}
